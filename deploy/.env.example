APP_NAME=chaoxing-web
APP_VERSION=4.0.0-alpha.1
DEBUG=false
HOST=0.0.0.0
PORT=8000
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_DB=chaoxing
POSTGRES_USER=chaoxing
POSTGRES_PASSWORD=replace-this-password
DATABASE_URL=postgresql+asyncpg://chaoxing:replace-this-password@postgres:5432/chaoxing
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=https://chaoxing.example.com
VITE_API_BASE_URL=/api/v1

API_BIND_PORT=18000
FRONTEND_BIND_PORT=18080

LEGACY_SQL_PATH=/app/data/migration/user-data-export.sql
LEGACY_REPORT_DIR=/app/data/migration
SMOKE_USERNAME=
SMOKE_PASSWORD=
